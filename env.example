# Required: TMDB API key (get free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: OMDB API key for additional ratings
OMDB_API_KEY=your_omdb_api_key_here

# Optional: Set a fixed JWT secret (auto-generated if not set)
JWT_SECRET=your_secret_here

# Optional: Port (default 3001)
PORT=3001

# Optional: CORS origin (default allows all)
CORS_ORIGIN=*
